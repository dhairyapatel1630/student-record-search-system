
students = []

# Function to enter and save student records
def add_students():
    n = int(input("How many students do you want to enter? "))

    for i in range(n):
        print(f"\nEnter details of Student {i + 1}")

        roll = int(input("Enter Roll Number: "))

        # Check duplicate roll number
        if any(s["roll"] == roll for s in students):
            print("Roll Number already exists. Enter again.")
            continue

        name = input("Enter Student Name: ")
        marks = float(input("Enter Marks: "))

        students.append({
            "roll": roll,
            "name": name,
            "marks": marks
        })

    print("\nStudent records saved successfully!")


# Function to display all records
def display_students():
    if not students:
        print("No student records available.")
        return

    print("\n--- All Student Records ---")
    print("Roll Number\tName\tMarks")

    for s in students:
        print(f"{s['roll']}\t\t{s['name']}\t{s['marks']}")


# Linear Search
def linear_search(roll):
    for s in students:
        if s["roll"] == roll:
            return s
    return None


# Binary Search
def binary_search(roll):
    ordered = sorted(students, key=lambda s: s["roll"])
    low = 0
    high = len(ordered) - 1

    while low <= high:
        mid = (low + high) // 2

        if ordered[mid]["roll"] == roll:
            return ordered[mid]
        elif ordered[mid]["roll"] < roll:
            low = mid + 1
        else:
            high = mid - 1

    return None


# Search and check student record
def search_student():
    if not students:
        print("Please enter student records first.")
        return

    roll = int(input("Enter Roll Number to search: "))

    print("1. Linear Search")
    print("2. Binary Search")
    choice = input("Choose search method: ")

    if choice == "1":
        result = linear_search(roll)
    elif choice == "2":
        result = binary_search(roll)
    else:
        print("Invalid choice!")
        return

    if result:
        print("\n--- Student Record Found ---")
        print("Roll Number:", result["roll"])
        print("Student Name:", result["name"])
        print("Marks:", result["marks"])

        if result["marks"] >= 35:
            print("Result: PASS")
        else:
            print("Result: FAIL")
    else:
        print("Student record not found!")


# Main program
while True:
    print("\n===== STUDENT RECORD SEARCH SYSTEM =====")
    print("1. Enter Student Records")
    print("2. Display All Records")
    print("3. Search Student Record")
    print("4. Exit")

    choice = input("Enter your choice: ")

    try:
        if choice == "1":
            add_students()
        elif choice == "2":
            display_students()
        elif choice == "3":
            search_student()
        elif choice == "4":
            print("Thank you!")
            break
        else:
            print("Invalid choice. Try again.")

    except ValueError:
        print("Invalid input! Please enter numeric values correctly.")
